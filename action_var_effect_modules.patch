--- a/workflow/rules/annotate_vep.smk
+++ b/workflow/rules/annotate_vep.smk
@@ -14,17 +14,86 @@ VEP_COLUMN_ARGS = column_args(VEP_COLUMNS, 'vep.columns')
 ALL_OUTPUTS.append(VARIANTS_VEP)
 
 
+# Optional effect-prediction annotations (all keys optional; omit a plugin to skip it).
+# Plugin data is not in the container: give paths under /storage, or add them to bind.
+#
+#   vep:
+#     sift: b                      # p = prediction, s = score, b = both
+#     polyphen: b
+#     bind: [/cluster/projects/...] # extra Singularity bind paths
+#     dir_plugins: /plugins        # only if VEP can't find the image's plugins
+#     plugins:
+#       dbNSFP:        {file: .../dbNSFP4.9a_grch38.gz,
+#                       fields: [REVEL_score, MetaRNN_score, AlphaMissense_score, AlphaMissense_pred]}
+#       AlphaMissense: {file: .../AlphaMissense_hg38.tsv.gz}
+#       REVEL:         {file: .../new_tabbed_revel_grch38.tsv.gz}
+#       dbscSNV:       {file: .../dbscSNV1.1_GRCh38.txt.gz}
+#       MaxEntScan:    {dir: .../fordownload}
+#       SpliceAI:      {snv: .../spliceai_scores.raw.snv.hg38.vcf.gz,
+#                       indel: .../spliceai_scores.raw.indel.hg38.vcf.gz}
+#     extra_plugins: []            # raw '--plugin' specs, passed through unchanged
+_DBNSFP_DEFAULT_FIELDS = ['REVEL_score', 'MetaRNN_score', 'AlphaMissense_score', 'AlphaMissense_pred']
+
+
+def vep_plugin_specs(vep):
+    """(specs, data_files): VEP --plugin specs and the data paths they need."""
+    plugins = vep.get('plugins') or {}
+    known = {'dbNSFP', 'AlphaMissense', 'REVEL', 'dbscSNV', 'MaxEntScan', 'SpliceAI'}
+    unknown = set(plugins) - known
+    if unknown:
+        raise ValueError(f"vep.plugins: unknown plugin(s) {sorted(unknown)}; "
+                         f"allowed: {sorted(known)} (use vep.extra_plugins for others)")
+    specs, files = [], []
+    for name, opts in plugins.items():
+        opts = opts or {}
+        if name == 'dbNSFP':
+            fields = opts.get('fields', _DBNSFP_DEFAULT_FIELDS)
+            specs.append(','.join(['dbNSFP', opts['file'], *fields]))
+            files.append(opts['file'])
+        elif name in ('AlphaMissense', 'REVEL'):
+            specs.append(f"{name},file={opts['file']}")
+            files.append(opts['file'])
+        elif name == 'dbscSNV':
+            specs.append(f"dbscSNV,{opts['file']}")
+            files.append(opts['file'])
+        elif name == 'MaxEntScan':
+            specs.append(f"MaxEntScan,{opts['dir']}")
+            files.append(opts['dir'])
+        elif name == 'SpliceAI':
+            parts = [f"{k}={opts[k]}" for k in ('snv', 'indel') if opts.get(k)]
+            if not parts:
+                raise ValueError("vep.plugins.SpliceAI needs at least one of snv/indel")
+            specs.append(','.join(['SpliceAI', *parts]))
+            files.extend(opts[k] for k in ('snv', 'indel') if opts.get(k))
+    specs.extend(vep.get('extra_plugins') or [])
+    return specs, files
+
+
+VEP_PLUGIN_SPECS, VEP_PLUGIN_FILES = vep_plugin_specs(VEP)
+_vep_extra = []
+for _key in ('sift', 'polyphen'):
+    if VEP.get(_key):
+        _vep_extra.append(f"--{_key} {VEP[_key]}")
+if VEP.get('dir_plugins'):
+    _vep_extra.append(f"--dir-plugins {shlex.quote(str(VEP['dir_plugins']))}")
+_vep_extra += [f"--bind {shlex.quote(str(b))}" for b in VEP.get('bind') or []]
+_vep_extra += [f"--plugin {shlex.quote(s)}" for s in VEP_PLUGIN_SPECS]
+VEP_EXTRA_ARGS = " ".join(_vep_extra)
+
+
 rule annotate_vep:
     input:
-        var=VARIANTS_HG38
+        var=VARIANTS_HG38,
+        plugin_data=VEP_PLUGIN_FILES,   # fail early if plugin data is missing
     output:
         vcf=VARIANTS_VEP
     params:
         script="workflow/scripts/annotate_vep.py",
         columns=VEP_COLUMN_ARGS,
+        extra=VEP_EXTRA_ARGS,
     shell:
         """
-        python {params.script} {input.var} {output.vcf} {params.columns}
+        python {params.script} {input.var} {output.vcf} {params.columns} {params.extra}
         """
 
 
diff --git a/workflow/rules/sei.smk b/workflow/rules/sei.smk
new file mode 100644
index 0000000..f127278
--- /dev/null
+++ b/workflow/rules/sei.smk
@@ -0,0 +1,120 @@
+# rules/sei.smk
+# Sei (Troyanskaya lab) sequence-class variant effects for the variants in
+# variant_effects, joined back onto that table. Requires the variant_effects module.
+#
+# One-off setup (see README, "Sei"):
+#   git clone https://github.com/FunctionLab/sei-framework && cd sei-framework
+#   sh ./download_data.sh            # model + hg19/hg38 FASTA, several GB
+#   a Python env with torch, selene-sdk, docopt (plus h5py, pandas)
+#
+#   sei:
+#     dir: /storage/.../sei-framework     # required: the cloned, set-up framework
+#     run_prefix: conda run --no-capture-output -n sei   # how to run its Python; "" if active
+#     outdir: results/<vep stem>_sei
+#     include: noncoding                  # or: all
+#     snv_only: false
+#     cuda: false                         # true on a GPU node (step 1 is slow on CPU)
+#     resources: {}                       # passed to the executor for step 1, e.g.
+#                                         #   {slurm_partition: accel, gpus: 1, runtime: 240}
+
+if 'VARIANT_EFFECTS' not in globals():
+    raise WorkflowError("sei needs the variant_effects module; add it to 'modules'")
+
+SEI = config.get('sei') or {}
+if not SEI.get('dir'):
+    raise WorkflowError("sei.dir must point to a set-up sei-framework checkout")
+SEI_FRAMEWORK = os.path.abspath(SEI['dir'])
+SEI_PREFIX = SEI.get('run_prefix', '')
+SEI_OUT = SEI.get('outdir', f"{os.path.splitext(VARIANTS_VEP)[0]}_sei")
+SEI_RESOURCES = SEI.get('resources') or {}
+
+SEI_VCF = f"{SEI_OUT}/sei_input.vcf"
+_SEI_H5 = f"{SEI_OUT}/chromatin-profiles-hdf5"
+SEI_REF = f"{_SEI_H5}/sei_input.ref_predictions.h5"
+SEI_ALT = f"{_SEI_H5}/sei_input.alt_predictions.h5"
+SEI_LABELS = f"{_SEI_H5}/sei_input_row_labels.txt"
+SEI_NPY = f"{SEI_OUT}/sei_input.sequence_class_scores.npy"
+SEI_MERGED = f"{SEI_OUT}/variant_effects_sei.tsv"
+SEI_LONG = f"{SEI_OUT}/sei_sequence_class_scores_long.tsv"
+
+ALL_OUTPUTS.extend([SEI_MERGED, SEI_LONG])
+
+
+rule sei_vcf:
+    input:
+        effects=VARIANT_EFFECTS
+    output:
+        vcf=SEI_VCF
+    params:
+        script="workflow/scripts/prepare_sei_vcf.py",
+        include=SEI.get('include', 'noncoding'),
+        snv_only="--snv-only" if SEI.get('snv_only') else "",
+    shell:
+        """
+        python {params.script} {input.effects} {output.vcf} \
+            --include {params.include} {params.snv_only}
+        """
+
+
+# Step 1: 21,907 chromatin-profile predictions for ref and alt (the slow, GPU step).
+# The Sei scripts use paths relative to the framework dir, so they are run from there.
+rule sei_chromatin:
+    input:
+        vcf=SEI_VCF
+    output:
+        ref=SEI_REF,
+        alt=SEI_ALT,
+        labels=SEI_LABELS,
+    params:
+        framework=SEI_FRAMEWORK,
+        prefix=SEI_PREFIX,
+        vcf=lambda wc, input: os.path.abspath(input.vcf),
+        outdir=os.path.abspath(SEI_OUT),
+        cuda="--cuda" if SEI.get('cuda') else "",
+    resources:
+        **SEI_RESOURCES
+    shell:
+        """
+        cd {params.framework}
+        {params.prefix} sh 1_variant_effect_prediction.sh {params.vcf} hg38 {params.outdir} {params.cuda}
+        """
+
+
+# Step 2: sequence-class scores (alt - ref, histone-normalised); fast, CPU is fine.
+# --no-tsv skips Sei's sorted 21,907-column TSVs; merge_sei_scores.py reads the .npy.
+rule sei_seqclass:
+    input:
+        ref=SEI_REF,
+        alt=SEI_ALT,
+        labels=SEI_LABELS,
+    output:
+        npy=SEI_NPY
+    params:
+        framework=SEI_FRAMEWORK,
+        prefix=SEI_PREFIX,
+        ref=lambda wc, input: os.path.abspath(input.ref),
+        alt=lambda wc, input: os.path.abspath(input.alt),
+        outdir=os.path.abspath(SEI_OUT),
+    shell:
+        """
+        cd {params.framework}
+        {params.prefix} sh 2_varianteffect_sc_score.sh {params.ref} {params.alt} {params.outdir} --no-tsv
+        """
+
+
+rule sei_merge:
+    input:
+        npy=SEI_NPY,
+        labels=SEI_LABELS,
+        effects=VARIANT_EFFECTS,
+    output:
+        merged=SEI_MERGED,
+        long=SEI_LONG,
+    params:
+        script="workflow/scripts/merge_sei_scores.py",
+        seqclass=f"{SEI_FRAMEWORK}/model/seqclass.names",
+    shell:
+        """
+        python {params.script} {input.npy} {input.labels} {params.seqclass} \
+            {input.effects} {output.merged} --long {output.long}
+        """
